# --- Image provider -------------------------------------------------------
# Which backend generates images: "cloudflare" (default), "together" or "fal".
PALETTE_PROVIDER=cloudflare

# Cloudflare Workers AI - free, no deposit or card required.
# 10,000 Neurons a day (~173 FLUX images), resets daily.
#   Account id: Cloudflare dashboard home page, right-hand sidebar
#   API token:  https://dash.cloudflare.com/profile/api-tokens
#               "Create Token" -> use the "Workers AI" template (read is enough)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Together AI - free FLUX.1-schnell-Free tier, but the account must be out of
# read-only mode. Create a key at https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# fal.ai - paid, per image. Only needed when PALETTE_PROVIDER=fal.
# Create a key at https://fal.ai/dashboard/keys
FAL_KEY=
