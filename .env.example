# --- Image provider -------------------------------------------------------
# Which backend generates images: "together" (default) or "fal".
PALETTE_PROVIDER=together

# Together AI - free. The default 'schnell' tier maps to FLUX.1-schnell-Free,
# which costs nothing. Create a key at https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# fal.ai - paid, per image. Only needed when PALETTE_PROVIDER=fal.
# Create a key at https://fal.ai/dashboard/keys
FAL_KEY=
